# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올리지 않는다.
#   cp .env.example .env

# 세션·CSRF 서명용 비밀키. 아래 명령으로 만든 값을 붙여 넣는다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 개발 중에만 True. 운영·시연 서버에서는 False.
DJANGO_DEBUG=True

# 접속을 허용할 주소(쉼표로 구분)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker-compose의 db 컨테이너가 이 값으로 만들어진다)
POSTGRES_DB=aieval
POSTGRES_USER=aieval
POSTGRES_PASSWORD=
